{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GarrettAudet/SWECircuit/schemas/v1alpha1/adaptive-run.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/expectation"
    },
    {
      "$ref": "#/$defs/launchCommand"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/session"
    }
  ],
  "$defs": {
    "expectation": {
      "type": "object",
      "properties": {
        "compilationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "packageDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "policyDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "calibrationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inventoryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "assignmentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "runRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "predecessorRun": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "runId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "sessionDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "terminalOutcome": {
                  "enum": ["fix", "diagnose", "clarify", "redesign", "split", "block", "learn"]
                },
                "evidenceDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": ["runId", "sessionDigest", "terminalOutcome", "evidenceDigest"],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceBaselineDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "authorizedHostId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authorizedAdapterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authorizedAdapterRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "authorizationIssuerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maxHostEvents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "lineageDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "maxLineageDepth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        }
      },
      "required": [
        "compilationDigest",
        "packageDigest",
        "policyDigest",
        "calibrationDigest",
        "inventoryDigest",
        "assignmentDigest",
        "runId",
        "runRevision",
        "predecessorRun",
        "workspaceBaselineDigest",
        "authorizedHostId",
        "authorizedAdapterId",
        "authorizedAdapterRevision",
        "authorizationIssuerId",
        "maxHostEvents",
        "lineageDepth",
        "maxLineageDepth"
      ],
      "additionalProperties": false
    },
    "launchCommand": {
      "type": "object",
      "properties": {
        "agentContractPath": {
          "type": "string",
          "maxLength": 16384
        },
        "agentContractDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "agentContractBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "contextSources": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "locator": {
                "type": "string",
                "maxLength": 16384
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 134217728
              },
              "delivery": {
                "enum": ["host_context", "authorized_filesystem_read"]
              }
            },
            "required": ["sourceId", "locator", "digest", "bytes", "delivery"],
            "additionalProperties": false
          }
        },
        "profileId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "effortId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tools": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "skills": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "isolationFeatures": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "permissions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "filesystem.read",
                  "filesystem.write",
                  "network.connect",
                  "process.spawn",
                  "secrets.read"
                ]
              },
              "scopes": {
                "type": "array",
                "maxItems": 256,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "required": ["kind", "scopes"],
            "additionalProperties": false
          }
        },
        "observability": {
          "type": "object",
          "properties": {
            "model": {
              "enum": ["observed", "host_attestation_allowed"]
            },
            "effort": {
              "enum": ["observed", "host_attestation_allowed"]
            },
            "tools": {
              "enum": ["observed", "host_attestation_allowed"]
            },
            "skills": {
              "enum": ["observed", "host_attestation_allowed"]
            },
            "isolation": {
              "enum": ["observed", "host_attestation_allowed"]
            },
            "permissions": {
              "enum": ["observed", "host_attestation_allowed"]
            },
            "workspace": {
              "enum": ["observed", "host_attestation_allowed"]
            },
            "context": {
              "enum": ["observed", "host_attestation_allowed"]
            }
          },
          "required": [
            "model",
            "effort",
            "tools",
            "skills",
            "isolation",
            "permissions",
            "workspace",
            "context"
          ],
          "additionalProperties": false
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "agentContractPath",
        "agentContractDigest",
        "agentContractBytes",
        "contextSources",
        "profileId",
        "effortId",
        "tools",
        "skills",
        "isolationFeatures",
        "permissions",
        "observability",
        "contentDigest"
      ],
      "additionalProperties": false
    },
