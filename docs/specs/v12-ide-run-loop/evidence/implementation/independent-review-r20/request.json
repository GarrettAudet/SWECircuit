    "id": "v12.ide-run-loop.review.stable-reconstruction-authority-r20",
    "revision": 1,
    "objective": "Independently determine whether exact Revision 20 closes the Revision 19 package-identity cycle, cross-invocation gap, approval-label defect, Unicode and cache reproductions, and every related trust boundary without a new bypass.",
    "integrationOwner": "codex.main",
    "assumptions": [
      {
        "id": "assumption.producer-evidence-not-verdict",
        "statement": "The producer package, handoff, and test results are authenticated evidence but do not supply this review's semantic verdict.",
        "rationale": "Independent review must reason from exact source and primary evidence."
      },
      {
        "id": "assumption.read-only",
        "statement": "The reviewer has no write authority and reports defects without repairing bytes.",
        "rationale": "The reviewed source must remain immutable during semantic review."
      },
      {
        "id": "assumption.host-boundary",
        "statement": "Operating-system and executable trust, cache provenance, parent pin enforcement, process isolation, and hostile same-user resistance remain external-host duties.",
        "rationale": "Repository checks may bind declarations without manufacturing host guarantees."
      }
    ],
    "unresolvedDecisions": [],
    "acceptanceCriteria": [
      {
        "id": "criterion.review.stable-reconstruction-authority.r20",
        "description": "Exact Revision 20 closes every declared defect, preserves valid Revision 19 controls, proves one package across fresh phase authority, and introduces no release-blocking trust or test-quality finding.",
        "evidenceRequirements": [
          {
            "id": "evidence.review.stable-reconstruction-authority.r20",
            "kind": "review",
            "duty": "produce",
            "description": "Provide exact source authentication, disposition of every required review point, new-bypass analysis, test-quality analysis, residual host boundaries, and a concrete pass or correction route.",
            "independentFromProducer": false
          }
        ]
      }
    ],
