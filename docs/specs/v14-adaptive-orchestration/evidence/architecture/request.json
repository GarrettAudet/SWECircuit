          {
            "id": "evidence.routing-api",
            "kind": "review",
            "duty": "produce",
            "description": "Preserve the exact routing and public API architecture review.",
            "independentFromProducer": false
          }
        ]
      },
      {
        "id": "criterion.host-lifecycle",
        "description": "The host command, observation, controller, adapter, restore, and escalation boundaries are portable and do not revive the universal scheduler.",
        "evidenceRequirements": [
          {
            "id": "evidence.host-lifecycle",
            "kind": "review",
            "duty": "produce",
            "description": "Preserve the exact host lifecycle and portability review.",
            "independentFromProducer": false
          }
        ]
      },
      {
        "id": "criterion.security-evidence",
        "description": "Trust, authority, quality calibration, approval, drift, receipt, replay, and evidence semantics fail closed.",
        "evidenceRequirements": [
          {
            "id": "evidence.security-evidence",
            "kind": "review",
            "duty": "produce",
            "description": "Preserve the exact security and evidence review.",
            "independentFromProducer": false
          }
        ]
      },
      {
        "id": "criterion.product-runview",
        "description": "The one-goal IDE experience, serial baseline, RunView, interventions, and release claims remain simple and understandable.",
